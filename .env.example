# TELEGRAM AI VIDEO CLIPPING BOT CONFIGURATION

# Telegram Bot Token (Obtain for free from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Obtain for free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for video/transcript moment analysis (Free Tier)
GEMINI_MODEL=gemini-2.5-flash

# Default clipping options
MIN_CLIP_DURATION=15
MAX_CLIP_DURATION=60
MAX_CLIPS_COUNT=4
TARGET_ASPECT_RATIO=9:16
OUTPUT_RESOLUTION=720x1280

# Working directory for temporary processing
TEMP_STORAGE_DIR=storage_temp

# Auto cleanup temporary files after sending (1=yes, 0=no)
AUTO_CLEANUP=1
